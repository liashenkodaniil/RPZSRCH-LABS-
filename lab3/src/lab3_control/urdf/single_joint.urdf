<?xml version="1.0"?>
<robot name="lab3_single_joint">
  <link name="base_link"/>
  <link name="arm_link">
    <visual>
      <origin xyz="0.25 0 0"/>
      <geometry><box size="0.5 0.05 0.05"/></geometry>
    </visual>
  </link>

  <joint name="joint1" type="revolute">
    <parent link="base_link"/>
    <child link="arm_link"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14" effort="10" velocity="2"/>
  </joint>

  <ros2_control name="SimJoint" type="system">
    <hardware>
      <plugin>lab3_control/SimJointHardware</plugin>
      <param name="a_max">0.5</param>
      <param name="actuation_delay">0.1</param>
      <param name="feedback_delay">0.05</param>
      <param name="sim_dt">0.001</param>
    </hardware>
    <joint name="joint1">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>
</robot>
